{
  "name": "squares",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --filter @squares/web dev",
    "build": "pnpm --filter @squares/web build",
    "preview": "pnpm --filter @squares/web preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @squares/web test:watch",
    "test:e2e": "pnpm --filter @squares/web test:e2e",
    "test:e2e:static": "pnpm --filter @squares/web test:e2e:static",
    "test:all": "pnpm typecheck && pnpm test && pnpm test:e2e",
    "tokens": "pnpm --filter @squares/web tokens",
    "icons": "pnpm --filter @squares/artwork icons",
    "store-assets": "pnpm --filter @squares/artwork store-assets",
    "web": "pnpm --filter @squares/web dev",
    "web:build": "pnpm --filter @squares/web build",
    "web:preview": "pnpm --filter @squares/web preview",
    "mobile": "pnpm --filter @squares/mobile start",
    "mobile:ios": "pnpm --filter @squares/mobile ios",
    "mobile:aab": "pnpm --filter @squares/mobile build:aab",
    "mobile:apk": "pnpm --filter @squares/mobile build:apk"
  },
  "devDependencies": {
    "@squares/domain": "workspace:*"
  }
}
