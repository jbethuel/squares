{
  "compilerOptions": {
    "target": "ES2022",
    // No `dom`, deliberately. The rules must compile without a browser, or
    // apps/mobile cannot consume them — this is the guard that catches a DOM
    // type sneaking in before the mobile build does.
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
