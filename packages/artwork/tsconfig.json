{
  "compilerOptions": {
    "target": "ES2022",
    // No `dom`, for the same reason packages/domain has none: this draws PNGs
    // by writing bytes, and a canvas type sneaking in would mean it had quietly
    // started depending on a browser to do it.
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.mts"]
}
